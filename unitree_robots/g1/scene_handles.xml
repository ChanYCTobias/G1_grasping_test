<mujoco model="g1_two_handles">
  <include file="g1_29dof_with_hand.xml"/>

  <option timestep="0.001" gravity="0 0 -9.81" iterations="30" noslip_iterations="8"/>
  <size memory="32M"/>

  <visual>
    <global offwidth="960" offheight="720"/>
  </visual>

  <worldbody>
    <!-- Canonical object for the friction hold. Identity quaternion: posts along
         world Z, hands separated along Y. Mass is at the post centers (z=0.07).
         The bar does not collide, so it cannot hold the weight. -->
    <body name="payload" pos="0.3 0.2 0.9">
      <freejoint name="payload_free"/>
      <!-- Posts are centered at z=0.07, so the mass sits there too. -->
      <inertial pos="0 0 0.07" mass="1" diaginertia="0.008 0.002 0.006"/>
      <geom name="handle_l" type="cylinder" size="0.022 0.07" pos="0 0.082 0.07"
            rgba="0.72 0.74 0.78 1" friction="2 0.01 0.001" condim="4"/>
      <geom name="handle_r" type="cylinder" size="0.022 0.07" pos="0 -0.082 0.07"
            rgba="0.72 0.74 0.78 1" friction="2 0.01 0.001" condim="4"/>
      <geom name="bridge" type="cylinder" size="0.010 0.082" pos="0 0 0"
            quat="0.7071068 0.7071068 0 0" contype="0" conaffinity="0"
            rgba="0.55 0.57 0.60 1"/>
    </body>
  </worldbody>

  <equality>
    <weld name="pelvis_weld" body1="pelvis" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <!-- Off during the hold. Turned on only while the hands close, before the rod is live. -->
    <weld name="rod_freeze" body1="payload" active="false" solref="0.005 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
